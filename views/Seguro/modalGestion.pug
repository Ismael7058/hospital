//- Modal para gestionar una seguro existente (editar nombre, cambiar estado)
#modalGestionSeguro.modal.fade(tabindex="-1" aria-labelledby="modalGestionSeguroLabel" aria-hidden="true")
  .modal-dialog.modal-dialog-centered
    .modal-content
      .modal-header
        h5#modalGestionSeguroLabel.modal-title Gestionar Seguro
        button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")

      form#formGestionSeguro(autocomplete="off" novalidate)
        .modal-body
          input(type="hidden" id="gestion_seguro_id" name="id")

          #error-container-gestion-seguro.alert.alert-danger.d-none(role="alert")

          .mb-3
            label.form-label(for="gestion_nombre_seguro") Nombre del Seguro Medico
            input.form-control(type="text" id="gestion_nombre_seguro" name="nombre" required minlength="3")
            .invalid-feedback

        .modal-footer
          button#btn-desactivar-seguro.btn.btn-outline-danger.d-none(type="button" data-nuevo-estado="false")
            i.bi.bi-x-circle-fill.me-2
            | Desactivar
          button#btn-activar-seguro.btn.btn-outline-success.d-none(type="button" data-nuevo-estado="true")
            i.bi.bi-check-circle-fill.me-2
            | Activar
          button.btn.btn-primary.ms-2(type="submit")
            i.bi.bi-save-fill.me-2
            | Guardar Cambios
Section scripts
  script(src="/js/seguro/modalGestion.js" type="module")
