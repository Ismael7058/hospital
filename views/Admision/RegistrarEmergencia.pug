extends ../layout

block styles
  //- Select2 CSS para Bootstrap 5
  link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css")
  link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css")

block content
  .container-fluid.d-flex.flex-column.h-100.p-4
    form#registroPacienteForm.row.shadow-lg.rounded.border.bg-light.p-4.d-flex.flex-column.flex-grow-1.justify-content-between(novalidate autocomplete="off")
      h4.text-center.mt-4
        i.bi.bi-exclamation-circle-fill.me-2
        | Registrar Emergencia
      input(type="hidden" name="via_ingreso_id" value=viaIngresoFiltro.id)
      .row.g-4.mt-0
        .col-lg-6.d-flex.flex-column.gap-4
          .p-4.border.rounded.bg-white.shadow-sm
              //- Sección: Datos de Ingreso
              h6.text-muted.text-uppercase.fw-bold.mb-3 
                i.bi.bi-hospital.me-2
                | Datos de Ingreso
              
              .row.g-3
                .col-12
                  label.form-label.fw-bold(for="select-medico") Médico Responsable
                  select#select-medico.form-select(name="medico_id" required style="width: 100%;")
                    if medicoPreseleccionado
                      option(value=medicoPreseleccionado.id selected) #{medicoPreseleccionado.nombre} #{medicoPreseleccionado.apellido} (DNI: #{medicoPreseleccionado.dni})
                  .invalid-feedback#error-medico_id El médico es obligatorio.

          .p-4.border.rounded.bg-white.shadow-sm.flex-grow-1
              //- Sección: Motivo
              h6.text-muted.text-uppercase.fw-bold.mb-3 
                i.bi.bi-clipboard-pulse.me-2
                | Detalles Clínicos
              
              div
                label.form-label.fw-bold(for="emergencia-motivo") Motivo de Consulta / Observaciones
                textarea#emergencia-motivo.form-control(name="motivo" rows="5" placeholder="Describa brevemente el motivo de la urgencia...")



        .col-lg-6
          .h-100.p-4.border.rounded.bg-white.shadow-sm
            //- Sección: Paciente
            h6.text-muted.text-uppercase.fw-bold.mb-3 
              i.bi.bi-person-vcard.me-2
              | Identificación del Paciente

            .row.g-3
              .col-12
                label.form-label.fw-bold(for="select-paciente") Buscar Paciente Registrado
                select#select-paciente.form-select(name="paciente_id" style="width: 100%;")
                  if pacientePreseleccionado
                    - const dni = pacientePreseleccionado.identificaciones && pacientePreseleccionado.identificaciones.length > 0 ? pacientePreseleccionado.identificaciones[0].nro_doc : 'S/D'
                    option(value=pacientePreseleccionado.id selected) #{pacientePreseleccionado.nombre} #{pacientePreseleccionado.apellido} (DNI: #{dni})
                .form-text.text-muted Si el paciente ya existe, búsquelo aquí.

              .col-12
                .card.border-danger.bg-danger.bg-opacity-10
                  .card-body
                    h6.card-title.text-danger.fw-bold
                      i.bi.bi-person-plus-fill.me-2
                      | Paciente Temporal / No Identificado
                    p.card-text.small.text-muted Complete estos campos SOLO si no seleccionó un paciente arriba.
                    
                    .row.g-3
                      .col-md-6
                        label.form-label.small(for="nombre") Nombre
                        input.form-control.form-control-sm(type="text" name="nombre" placeholder="Ej: Juan / NN")
                      .col-md-6
                        label.form-label.small(for="apellido") Apellido
                        input.form-control.form-control-sm(type="text" name="apellido" placeholder="Ej: Perez / NN")
                      .col-md-4
                        label.form-label.small(for="sexo") Sexo *
                        select.form-select.form-select-sm(name="sexo")
                          option(value="" selected disabled) Seleccionar
                          option(value="Masculino") Masculino
                          option(value="Femenino") Femenino
                      .col-md-4
                        label.form-label.small(for="fecha_nacimiento") Fecha Nac.
                        input.form-control.form-control-sm(type="date" name="fecha_nacimiento")
                      .col-md-4
                        label.form-label.small(for="nro_doc") Documento
                        .input-group.input-group-sm
                          select.form-select(name="tipo_doc" style="max-width: 75px;")
                            option(value="DNI") DNI
                            option(value="Pasaporte") Pas
                          input.form-control(type="text" name="nro_doc" placeholder="Número")
          
        .col-12
          .p-4.border.rounded.bg-white.shadow-sm
            h6.text-muted.text-uppercase.fw-bold.mb-3 
              i.bi.bi-geo-alt.me-2
              | Asignación de Cama (Opcional)
            .row.g-3
              .col-md-4
                label.form-label(for="ala_id") Ala / Sector
                select.form-select(id="ala_id" name="ala_id")
                  option(value="") Seleccionar Ala
                  if alas
                    each ala in alas
                      option(value=ala.id) #{ala.nombre}
              .col-md-4
                label.form-label(for="habitacion_id") Habitación
                select.form-select(id="habitacion_id" name="habitacion_id" disabled)
                  option(value="") Seleccione Ala primero
              .col-md-4
                label.form-label(for="cama_id") Cama
                select.form-select(id="cama_id" name="cama_id" disabled)
                  option(value="") Seleccione Habitación primero

        .col-12.d-flex.justify-content-end.gap-2.mt-4
              a.btn.btn-secondary(href="/admisiones") Cancelar
              button.btn.btn-danger.px-4(type="submit")
                i.bi.bi-save-fill.me-2
                | Registrar Emergencia

block scripts
  //- jQuery y Select2 JS
  script(src="https://code.jquery.com/jquery-3.6.0.min.js")
  script(src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js")

  script(src="/js/admision/buscarMedico.js")
  script(src="/js/admision/buscarPaciente.js")
  script(src="/js/admision/ubicacion.js") 