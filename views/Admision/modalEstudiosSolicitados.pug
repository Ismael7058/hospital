#modalEstudiosSolicitados.modal.fade(tabindex="-1" aria-hidden="true")
  .modal-dialog.modal-dialog-centered(style="max-width: 540px;" )
    .modal-content.border-0.shadow-lg.rounded-3
      .modal-header.border-bottom.bg-light.bg-opacity-50.py-3.px-4.align-items-center
        .d-flex.align-items-center.gap-3
          .d-flex.align-items-center.justify-content-center.bg-primary.bg-opacity-10.text-primary.rounded-3(style="width: 40px; height: 40px;")
            i.bi.bi-shield-check.fs-4
          div
            h5.modal-title.fw-bold.text-dark.text-uppercase.fs-6.mb-0 Solicitar Nuevo Estudio
            p.small.fw-bold.text-muted.text-uppercase.mb-0(style="font-size: 10px;") Formulario de Solicitud de Estudios
        button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")

      form#formEstudiosSolicitados(autocomplete="off" novalidate)
        .modal-body.p-4
          input(type="hidden", name="admision_id" value=admision.id)

          .mb-3
            label.form-label.small.fw-bold.text-muted.text-uppercase(for="estudio" style="font-size: 10px; letter-spacing: 0.5px;") Nombre del Estudio
            input.form-control.border-start-0.bg-light(type="text" id="estudio" name="estudio" placeholder="Ej: Hemograma, Rayos X, Tomografía..." required)

          .mb-0
            label.form-label.small.fw-bold.text-muted.text-uppercase(for="descripcion" style="font-size: 10px; letter-spacing: 0.5px;") Motivo / Observaciones
            textarea.form-control.bg-light(id="descripcion" name="descripcion" placeholder="Ej: Descartar fractura, control de rutina..." rows="3" style="resize: none;  min-height: 200px;")

        .modal-footer.bg-light.bg-opacity-50.border-top.px-4.py-3
          button.btn.btn-light.text-muted.fw-bold.text-uppercase.small(type="button" data-bs-dismiss="modal" style="font-size: 12px;") Cancelar
          button.btn.btn-primary.fw-bold.text-uppercase.small.d-flex.align-items-center.gap-2(type="submit" style="font-size: 12px;")
            i.bi.bi-file-earmark-plus
            | Confirmar Solicitud