#modalSignosVitales.modal.fade(tabindex="-1" aria-hidden="true")
  .modal-dialog.modal-dialog-centered(style="max-width: 540px;" )
    .modal-content.border-0.shadow-lg.rounded-3
      .modal-header.border-bottom.bg-light.bg-opacity-50.py-3.px-4.align-items-center
        .d-flex.align-items-center.gap-3
          .d-flex.align-items-center.justify-content-center.bg-primary.bg-opacity-10.text-primary.rounded-3(style="width: 40px; height: 40px;")
            i.bi.bi-heart-pulse.fs-4
          div
            h5.modal-title.fw-bold.text-dark.text-uppercase.fs-6.mb-0 Nuevo Cuidado Realizados
            p.small.fw-bold.text-muted.text-uppercase.mb-0(style="font-size: 10px;") Formulario de Cuidado Realizados
        button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")

      form#formSignosVitales(autocomplete="off" novalidate)
        .modal-body.p-4
          input(type="hidden", name="admision_id" value=admision.id)

          .row.g-3.mb-3
            .col-6
              .d-flex.justify-content-between.align-items-center.mb-1
                label.form-label.small.fw-bold.text-muted.text-uppercase.mb-0(for="frecuencia_cardiaca" style="font-size: 10px; letter-spacing: 0.5px;") Frecuencia Cardiaca
                span.badge.rounded-pill.bg-success-subtle.text-success-emphasis.fw-normal (30 - 250 lpm)
              .input-group
                input.form-control.bg-light.border-end-0(type="number" id="frecuencia_cardiaca" name="frecuencia_cardiaca" required)
                span.input-group-text.bg-light.text-muted.border-start-0 bpm
            .col-6
              .d-flex.justify-content-between.align-items-center.mb-1
                label.form-label.small.fw-bold.text-muted.text-uppercase.mb-0(for="presion_arterial" style="font-size: 10px; letter-spacing: 0.5px;") Presion Arterial
                span.badge.rounded-pill.bg-success-subtle.text-success-emphasis.fw-normal (50/30-300/200 mmHg)
              .input-group
                input.form-control.bg-light.border-end-0(type="text" id="presion_arterial" name="presion_arterial" required)
                span.input-group-text.bg-light.text-muted.border-start-0 mmHg
            .col-6
              .d-flex.justify-content-between.align-items-center.mb-1
                label.form-label.small.fw-bold.text-muted.text-uppercase.mb-0(for="saturacion_oxigeno" style="font-size: 10px; letter-spacing: 0.5px;") Saturacion de Oxigeno
                span.badge.rounded-pill.bg-success-subtle.text-success-emphasis.fw-normal 60% y 100%
              .input-group
                input.form-control.bg-light.border-end-0(type="number" id="saturacion_oxigeno" name="saturacion_oxigeno" required)
                span.input-group-text.bg-light.text-muted.border-start-0 %
            .col-6
              .d-flex.justify-content-between.align-items-center.mb-1
                label.form-label.small.fw-bold.text-muted.text-uppercase.mb-0(for="temperatura" style="font-size: 10px; letter-spacing: 0.5px;") Temperatura
                span.badge.rounded-pill.bg-success-subtle.text-success-emphasis.fw-normal (15-45 °C)
              .input-group
                input.form-control.bg-light.border-end-0(type="number" step="0.1" id="temperatura" name="temperatura" required)
                span.input-group-text.bg-light.text-muted.border-start-0 °C

        .modal-footer.bg-light.bg-opacity-50.border-top.px-4.py-3
          button.btn.btn-light.text-muted.fw-bold.text-uppercase.small(type="button" data-bs-dismiss="modal" style="font-size: 12px;") Cancelar
          button.btn.btn-primary.fw-bold.text-uppercase.small.d-flex.align-items-center.gap-2(type="submit" style="font-size: 12px;")
            i.bi.bi-capsule
            | Confirmar Cuidado