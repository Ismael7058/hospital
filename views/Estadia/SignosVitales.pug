extends ../layout

block content
  .container-fluid.d-flex.flex-column.h-100.p-4
    .card.shadow-lg.border-0.d-flex.flex-column.flex-grow-1.overflow-hidden
      //- Header Paciente
      .bg-dark.text-white.p-4.flex-shrink-0
        .d-flex.align-items-center.gap-4
          .rounded-circle.bg-white.bg-opacity-10.d-flex.align-items-center.justify-content-center(style="width: 60px; height: 60px;")
            i.bi.bi-person-fill.fs-2.text-white
          .flex-grow-1.row.g-4
            .col-md-3
              p.small.text-white-50.text-uppercase.fw-bold.mb-1 Nombre Completo
              p.h5.fw-bold.mb-0.text-light #{admision.paciente.nombre} #{admision.paciente.apellido}
            .col-md-2
              p.small.text-white-50.text-uppercase.fw-bold.mb-1 Edad
              -
                const fechaNac = new Date(admision.paciente.fecha_nacimiento);
                const hoy = new Date();
                let edad = hoy.getFullYear() - fechaNac.getFullYear();
                const m = hoy.getMonth() - fechaNac.getMonth();
                if (m < 0 || (m === 0 && hoy.getDate() < fechaNac.getDate())) {
                  edad--;
                }
              p.fw-semibold.text-white.mb-0 #{edad} años
            .col-md-2
              p.small.text-white-50.text-uppercase.fw-bold.mb-1 Sexo
              p.fw-semibold.text-white.mb-0 #{admision.paciente.sexo}
            .col-md-3
              p.small.text-white-50.text-uppercase.fw-bold.mb-1 Identificación
              if admision.paciente.identificaciones && admision.paciente.identificaciones.length > 0
                .d-flex.flex-wrap.gap-1
                  each ident in admision.paciente.identificaciones
                    span.badge.bg-white.text-dark.bg-opacity-75 #{ident.tipo_doc}: #{ident.nro_doc}
              else
                p.fw-semibold.text-white.mb-0 --
            .col-md-2
              p.small.text-white-50.text-uppercase.fw-bold.mb-1 ID Paciente
              p.font-monospace.fw-semibold.text-white.mb-0 ##{admision.paciente.id}

      //- Filtros
      .bg-light.border-bottom.p-3.flex-shrink-0
        form(method="GET")
          .row.g-3.align-items-center
            .col-md-3
              label.form-label.small.fw-bold.text-uppercase.text-muted(for="activo") Estado
              select#activo.form-select.form-select-sm(name="activo")
                option(value="") Todos
                option(value="true" selected=(filtros && filtros.activo === 'true')) Activo
                option(value="false" selected=(filtros && filtros.activo === 'false')) Inactivo
            
            .col-md-9.d-flex.justify-content-end.align-items-cente
              .d-flex.gap-2
                a.btn.btn-sm.btn-outline-secondary(href=`/admisiones/${admision.id}/estadia`)
                  i.bi.bi-arrow-left.me-2
                  | Volver
                a.btn.btn-sm.btn-outline-secondary(href=`/admisiones/${admision.id}/evolucion-medica` title="Limpiar Filtros") 
                  i.bi.bi-eraser
                  | Limpiar
                button.btn.btn-sm.btn-primary(type="submit") 
                  i.bi.bi-search.me-1
                  | Filtrar

      //- Tabla
      .card-body.p-0.flex-grow-1.overflow-auto.position-relative
        table.table.table-hover.table-striped.align-middle.mb-0
          thead.table-light.sticky-top
            tr
              th.py-3.ps-4(style="width: 20%;") Fecha y Hora
              th.py-3(style="width: 15%;") Frec. Cardíaca
              th.py-3(style="width: 15%;") Pres. Arterial
              th.py-3(style="width: 15%;") Sat. Oxígeno
              th.py-3(style="width: 15%;") Temperatura
              th.py-3.text-center(style="width: 10%;") Acciones

          tbody
            if admision.signos_vitales && admision.signos_vitales.length > 0
              each signo in admision.signos_vitales
                tr
                  td.ps-4.text-muted.fw-semibold #{signo.fecha_hora.toLocaleString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' })} hs
                  td.text-muted #{signo.frecuencia_cardiaca} bpm
                  td.text-muted #{signo.presion_arterial} mmHg
                  td.text-muted #{signo.saturacion_oxigeno} %
                  td.text-muted #{signo.temperatura} °C
                  td.text-center
                    button.btn.btn-outline-primary.btn-sm(type="button" data-bs-toggle="modal" data-bs-target="#modalVerSignos" data-fecha=signo.fecha_hora.toISOString() data-frecuencia=signo.frecuencia_cardiaca data-presion=signo.presion_arterial data-saturacion=signo.saturacion_oxigeno data-temperatura=signo.temperatura title="Ver Detalles")
                      i.bi.bi-eye
              
              - const filasVacias = (paginacion.registrosPorPagina || 10) - admision.signos_vitales.length;
              if filasVacias > 0
                - for (let i = 0; i < filasVacias; i++)
                  tr
                    td(colspan="6") &nbsp;
            
        if !admision.signos_vitales || admision.signos_vitales.length === 0
          .d-flex.flex-column.align-items-center.justify-content-center.h-100.text-muted
             i.bi.bi-activity.display-1.mb-3.opacity-25
             h5.fw-light No hay signos vitales registrados

      if paginacion && paginacion.totalPaginas > 1
        .card-footer.bg-white.border-top.py-3.d-flex.justify-content-between.align-items-center
          div.text-muted
            small Página #{paginacion.paginaActual} de #{paginacion.totalPaginas} (#{paginacion.totalRegistros} registros)
          include ../Shared/Paginacion.pug

    #modalVerSignos.modal.fade(tabindex="-1" aria-hidden="true")
      .modal-dialog.modal-dialog-centered
        .modal-content.border-0.shadow-lg
          .modal-header.bg-primary.text-white
            h5.modal-title
              i.bi.bi-activity.me-2
              | Detalle Signos Vitales
            button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Close")
          .modal-body.p-4
            .mb-3
              label.fw-bold.text-primary.small.text-uppercase.mb-1 Fecha y Hora
              p#modalFecha.text-dark.fw-semibold.fs-5
            .row.g-3.mb-3
              .col-6
                label.fw-bold.text-primary.small.text-uppercase.mb-1 Frec. Cardíaca
                p#modalFrecuencia.text-secondary.mb-0
              .col-6
                label.fw-bold.text-primary.small.text-uppercase.mb-1 Pres. Arterial
                p#modalPresion.text-secondary.mb-0
              .col-6
                label.fw-bold.text-primary.small.text-uppercase.mb-1 Sat. Oxígeno
                p#modalSaturacion.text-secondary.mb-0
              .col-6
                label.fw-bold.text-primary.small.text-uppercase.mb-1 Temperatura
                p#modalTemperatura.text-secondary.mb-0
          .modal-footer.bg-light
            button.btn.btn-secondary.px-4(type="button" data-bs-dismiss="modal") Cerrar

block scripts
  script.
    document.addEventListener('DOMContentLoaded', function () {
      var modalVerSignos = document.getElementById('modalVerSignos');
      if (modalVerSignos) {
        modalVerSignos.addEventListener('show.bs.modal', function (event) {
          var button = event.relatedTarget;
          var fecha = button.getAttribute('data-fecha');
          var frecuencia = button.getAttribute('data-frecuencia');
          var presion = button.getAttribute('data-presion');
          var saturacion = button.getAttribute('data-saturacion');
          var temperatura = button.getAttribute('data-temperatura');

          var modalFecha = modalVerSignos.querySelector('#modalFecha');
          var modalFrecuencia = modalVerSignos.querySelector('#modalFrecuencia');
          var modalPresion = modalVerSignos.querySelector('#modalPresion');
          var modalSaturacion = modalVerSignos.querySelector('#modalSaturacion');
          var modalTemperatura = modalVerSignos.querySelector('#modalTemperatura');

          var date = new Date(fecha);

          modalFecha.textContent = date.toLocaleString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) + ' hs';
          modalFrecuencia.textContent = frecuencia + ' bpm';
          modalPresion.textContent = presion + ' mmHg';
          modalSaturacion.textContent = saturacion + ' %';
          modalTemperatura.textContent = temperatura + ' °C';
        });
      }
      
      // Re-initialize tooltips
      var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
      var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
      });
    });