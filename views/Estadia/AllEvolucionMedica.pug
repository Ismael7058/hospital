extends ../layout

block content
  .container-fluid.d-flex.flex-column.h-100.p-4
    .card.shadow-lg.border-0.d-flex.flex-column.flex-grow-1.overflow-hidden.rounded-0
      //- Paciente Header
      .bg-dark.text-white.p-4.flex-shrink-0
        .d-flex.align-items-center.gap-4
          .rounded-circle.bg-white.bg-opacity-10.d-flex.align-items-center.justify-content-center(style="width: 60px; height: 60px;")
            i.bi.bi-person-fill.fs-2.text-white
          .flex-grow-1.row.g-4
            .col-md-3
              p.small.text-white-50.text-uppercase.fw-bold.mb-1 Nombre Completo
              p.h5.fw-bold.mb-0.text-light #{paciente.nombre} #{paciente.apellido}
            .col-md-2
              p.small.text-white-50.text-uppercase.fw-bold.mb-1 Edad
              -
                const fechaNac = new Date(paciente.fecha_nacimiento);
                const hoy = new Date();
                let edad = hoy.getFullYear() - fechaNac.getFullYear();
                const m = hoy.getMonth() - fechaNac.getMonth();
                if (m < 0 || (m === 0 && hoy.getDate() < fechaNac.getDate())) {
                  edad--;
                }
              p.fw-semibold.text-white.mb-0 #{edad} años
            .col-md-2
              p.small.text-white-50.text-uppercase.fw-bold.mb-1 Sexo
              p.fw-semibold.text-white.mb-0 #{paciente.sexo}
            .col-md-3
              p.small.text-white-50.text-uppercase.fw-bold.mb-1 Identificación
              if paciente.identificaciones && paciente.identificaciones.length > 0
                .d-flex.flex-wrap.gap-1
                  each ident in paciente.identificaciones
                    span.badge.bg-white.text-dark.bg-opacity-75 #{ident.tipo_doc}: #{ident.nro_doc}
              else
                p.fw-semibold.text-white.mb-0 --
            .col-md-2
              p.small.text-white-50.text-uppercase.fw-bold.mb-1 ID Paciente
              p.font-monospace.fw-semibold.text-white.mb-0 ##{paciente.id}

      //- Filtros
      .bg-light.border-bottom.p-3.flex-shrink-0
        form(method="GET")
          .row.g-3.align-items-center
            .col-md-3
              label.form-label.small.fw-bold.text-uppercase.text-muted(for="activo") Estado
              select#activo.form-select.form-select-sm(name="activo")
                option(value="") Todos
                option(value="true" selected=(filtros && filtros.activo === 'true')) Activo
                option(value="false" selected=(filtros && filtros.activo === 'false')) Inactivo
            
            .col-md-9.d-flex.justify-content-end.align-items-center
              .d-flex.gap-2
                a.btn.btn-sm.btn-outline-secondary(href=`/pacientes/${paciente.id}`)
                  i.bi.bi-arrow-left.me-2
                  | Volver
                a.btn.btn-sm.btn-outline-secondary(href=`/pacientes/${paciente.id}/evolucion-medica` title="Limpiar Filtros") 
                  i.bi.bi-eraser
                  | Limpiar
                button.btn.btn-sm.btn-primary(type="submit") 
                  i.bi.bi-search.me-1
                  | Filtrar

      //- Tabla
      .card-body.p-0.flex-grow-1.overflow-auto.position-relative
        table.table.table-hover.table-striped.align-middle.mb-0
          thead.table-light.sticky-top
            tr
              th.py-3.ps-4(style="width: 15%;") Fecha y Hora
              th.py-3(style="width: 30%;") Diagnóstico
              th.py-3(style="width: 25%;") Tratamiento
              th.py-3.text-center(style="width: 10%;") Acciones

          tbody
            if evoluciones && evoluciones.length > 0
              each evolucion in evoluciones
                tr
                  td.ps-4.text-muted.fw-semibold #{evolucion.fecha_hora.toLocaleString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' })} hs
                  td.text-muted.text-truncate(style="max-width: 300px;" title=evolucion.diagnostico data-bs-toggle="tooltip") #{evolucion.diagnostico}
                  td.text-muted.text-truncate(style="max-width: 250px;" title=evolucion.tratamiento_ajuste data-bs-toggle="tooltip") #{evolucion.tratamiento_ajuste}
                  td.text-center
                    button.btn.btn-outline-primary.btn-sm(type="button" data-bs-toggle="modal" data-bs-target="#modalVerEvolucion" data-fecha=evolucion.fecha_hora.toISOString() data-diagnostico=evolucion.diagnostico data-tratamiento_ajuste=evolucion.tratamiento_ajuste title="Ver Detalles")
                      i.bi.bi-eye

              - const filasVacias = (paginacion.registrosPorPagina || 10) - evoluciones.length;
              if filasVacias > 0
                - for (let i = 0; i < filasVacias; i++)
                  tr
                    td(colspan="4") &nbsp;
            
        if !evoluciones || evoluciones.length === 0
          .d-flex.flex-column.align-items-center.justify-content-center.h-100.text-muted
             i.bi.bi-journal-medical.display-1.mb-3.opacity-25
             h5.fw-light No hay evoluciones médicas registradas
    
      if paginacion && paginacion.totalPaginas > 1
        .card-footer.bg-white.border-top.py-3.d-flex.justify-content-between.align-items-center
          div.text-muted
            small Página #{paginacion.paginaActual} de #{paginacion.totalPaginas} (#{paginacion.totalRegistros} registros)
          include ../Shared/Paginacion.pug

    #modalVerEvolucion.modal.fade(tabindex="-1" aria-hidden="true")
      .modal-dialog.modal-dialog-centered.modal-lg
        .modal-content.border-0.shadow-lg
          .modal-header.bg-primary.text-white
            h5.modal-title
              i.bi.bi-journal-medical.me-2
              | Detalle de Evolución Médica
            button.btn-close.btn-close-white(type="button" data-bs-dismiss="modal" aria-label="Close")
          .modal-body.p-4
            .row.g-3
              .col-md-6
                label.fw-bold.text-primary.small.text-uppercase.mb-1 Fecha y Hora
                p#modalFecha.text-dark.fw-semibold.fs-5
            hr
            .mb-3
              label.fw-bold.text-primary.small.text-uppercase.mb-1 Diagnóstico
              .bg-light.p-3.rounded.border
                 p#modalDiagnostico.text-secondary.mb-0
            .mb-0
              label.fw-bold.text-primary.small.text-uppercase.mb-1 Tratamiento
              .bg-light.p-3.rounded.border
                 p#modalTratamiento.text-secondary.mb-0
          .modal-footer.bg-light
            button.btn.btn-secondary.px-4(type="button" data-bs-dismiss="modal") Cerrar

block scripts
  script.
    document.addEventListener('DOMContentLoaded', function () {
      var modalVerEvolucion = document.getElementById('modalVerEvolucion');
      if (modalVerEvolucion) {
        modalVerEvolucion.addEventListener('show.bs.modal', function (event) {
          var button = event.relatedTarget;
          var fecha = button.getAttribute('data-fecha');
          var medico = button.getAttribute('data-medico');
          var diagnostico = button.getAttribute('data-diagnostico');
          var tratamiento_ajuste = button.getAttribute('data-tratamiento_ajuste');

          var modalFecha = modalVerEvolucion.querySelector('#modalFecha');
          var modalDiagnostico = modalVerEvolucion.querySelector('#modalDiagnostico');
          var modalTratamiento = modalVerEvolucion.querySelector('#modalTratamiento');

          var date = new Date(fecha);
          modalFecha.textContent = date.toLocaleString('es-AR', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) + ' hs';
          modalDiagnostico.textContent = diagnostico;
          modalTratamiento.textContent = tratamiento_ajuste;
        });
      }

      var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
      var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
      });
    });
