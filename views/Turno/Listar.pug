extends ../layout

block styles
  //- Select2 CSS para Bootstrap 5
  link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css")
  link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css")


block content
  .container-fluid.p-4.d-flex.flex-column.h-100
    .card.shadow-lg.border-0.d-flex.flex-column.flex-grow-1
      .card-header.bg-light.d-flex.justify-content-between.align-items-center.py-3
        div
          h4.mb-1
            | #{title}
          if pacienteFiltro
            h5.text-muted Paciente: #{pacienteFiltro.nombre} #{pacienteFiltro.apellido}
            div.d-flex.align-items-center.text-muted
              i.bi.bi-person-vcard.me-1
              if pacienteFiltro.identificaciones && pacienteFiltro.identificaciones.length > 0
                span= `${pacienteFiltro.identificaciones[0].tipo_doc} ${pacienteFiltro.identificaciones[0].nro_doc}`
                if pacienteFiltro.identificaciones.length > 1
                  - const otrasIdentificaciones = pacienteFiltro.identificaciones.slice(1).map(id => `<div>${id.tipo_doc} ${id.nro_doc}</div>`).join('');
                  span.badge.bg-secondary.ms-2(style="cursor: pointer;" data-bs-toggle="popover" data-bs-trigger="hover" data-bs-html="true" data-bs-content=otrasIdentificaciones)
                    | +#{pacienteFiltro.identificaciones.length - 1}
              else
                h2.mb-1
                  i.bi.bi-journal-medical.me-1.text-primary
                  | #{title}
        div
          button.btn.btn-outline-secondary.me-2(type="button" data-bs-toggle="collapse" data-bs-target="#filtrosCollapse" aria-expanded="false" aria-controls="filtrosCollapse")
            i.bi.bi-funnel-fill.me-2
            | Filtros
          a.btn.btn-success(href="/turnos/registrar")
            i.bi.bi-calendar-plus.me-2
            | Nuevo Turno

      .collapse#filtrosCollapse
        form.card-body.border-bottom.px-4(method='GET' action='/turnos')
          .row.g-4
            //- Columna Izquierda: Búsqueda de Entidades (Médico/Paciente)
            .col-lg-4
              h6.text-muted.mb-3.small.text-uppercase.fw-bold
                i.bi.bi-people.me-2
                | Búsqueda
              .d-flex.flex-column.gap-3
                div
                  label.form-label.small.fw-bold(for="select-medico") Médico
                  .input-group
                    select#select-medico.form-select(name="medico_id")
                      if medicoFiltro
                        option(value=medicoFiltro.id selected) #{medicoFiltro.nombre} #{medicoFiltro.apellido} (DNI: #{medicoFiltro.dni})
                    button#btn-limpiar-medico.btn.btn-outline-secondary(type="button" title="Limpiar selección")
                      i.bi.bi-x-lg
                div
                  label.form-label.small.fw-bold(for="select-paciente") Paciente
                  .input-group
                    select#select-paciente.form-select(name="paciente_id")
                      if pacienteFiltro
                        - const dni = pacienteFiltro.identificaciones && pacienteFiltro.identificaciones.length > 0 ? pacienteFiltro.identificaciones[0].nro_doc : 'S/D'
                        option(value=pacienteFiltro.id selected) #{pacienteFiltro.nombre} #{pacienteFiltro.apellido} (DNI: #{dni})
                    button#btn-limpiar-paciente.btn.btn-outline-secondary(type="button" title="Limpiar selección")
                      i.bi.bi-x-lg
            //- Columna Derecha: Filtros de Estado y Fecha
            .col-lg-8
              h6.text-muted.mb-3.small.text-uppercase.fw-bold
                i.bi.bi-sliders.me-2
                | Criterios
              .row
                .col-md-4
                  label.form-label(for='fecha') Fecha
                  input#fecha.form-control(type='date' name='fecha' value=filtros.fecha)
                .col-md-4
                  label.form-label(for='estado') Estado
                  select#estado.form-select(name='estado')
                    option(value='') Todos
                    option(value='Pendiente' selected=(filtros.estado == 'Pendiente')) Pendiente
                    option(value='Confirmado' selected=(filtros.estado == 'Confirmado')) Confirmado
                    option(value='Cancelado' selected=(filtros.estado == 'Cancelado')) Cancelado
                    option(value='Finalizado' selected=(filtros.estado == 'Finalizado')) Finalizado
                .col-md-4.d-flex.align-items-end.justify-content-end.gap-2
                  a.btn.btn-sm.btn-outline-secondary.p-2(href=`/turnos` title="Limpiar Filtros") 
                    i.bi.bi-eraser
                    | Limpiar
                  button.btn.btn-sm.btn-primary.flex-grow-1.p-2(type="submit") 
                    i.bi.bi-search.me-1
                    | Filtrar
            //- Botones
            .col-lg-4.d-flex.align-items-start.justify-content-end.gap-2


      .card-body.flex-grow-1.d-flex.flex-column.p-0.overflow-hidden
        .table-responsive.table-fixed-height
          table.table.table-striped.table-hover.align-middle
            thead.table-dark
              tr
                th.text-center Fecha
                th.text-center Hora
                th.text-center Médico
                th.text-center Paciente
                th.text-center Motivo
                th.text-center Estado
                th.text-center Acciones
            tbody
              if turnos.length > 0
                each turno in turnos
                  tr
                    td.text-center #{new Date(turno.fecha).toLocaleDateString('es-AR', { timeZone: 'UTC' })}
                    td.text-center #{turno.hora_inicio ? turno.hora_inicio.slice(0, 5) : ''} - #{turno.hora_fin ? turno.hora_fin.slice(0, 5) : ''}
                    td.text-center #{turno.medico ? turno.medico.nombre + ' ' + turno.medico.apellido : 'N/A'}
                    td.text-center #{turno.paciente ? turno.paciente.nombre + ' ' + turno.paciente.apellido : 'N/A'}
                    td.text-center #{turno.motivo}
                    td.text-center
                      span.badge(class=(turno.estado === 'Confirmado' ? 'bg-success' : turno.estado === 'Cancelado' ? 'bg-danger' : 'bg-warning text-dark')) #{turno.estado}
                    td.text-center
                      .btn-group
                        a.btn.btn-primary.btn-sm.me-1(href=`/turnos/${turno.id}`)
                          i.bi.bi-pencil-square.me-1
                          | Gestionar
                - const filasVacias = (paginacion.registrosPorPagina || 13) - turnos.length;
                if filasVacias > 0
                  - for (let i = 0; i < filasVacias; i++)
                    tr
                      td.text-center(colspan='7') &nbsp;
          if !turnos || turnos.length === 0
            .position-absolute.top-50.start-50.translate-middle.text-center.text-muted
              h4.fw-light No se encontraron turnos.

        //- Paginación
        if paginacion && paginacion.totalPaginas > 1
          .card-footer.d-flex.justify-content-between.align-items-center
            div.text-muted
              small Página #{paginacion.paginaActual} de #{paginacion.totalPaginas} (#{paginacion.totalRegistros} registros)
            include ../Shared/Paginacion.pug

block scripts 
  //- jQuery y Select2 JS
  script(src="https://code.jquery.com/jquery-3.6.0.min.js")
  script(src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js")

  script(src="/js/medico/buscarMedico.js")
  script(src="/js/paciente/buscarPaciente.js")