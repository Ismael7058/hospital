extends ../layout

block styles
  //- Select2 CSS para Bootstrap 5
  link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css")
  link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css")

block content
  .container-fluid.d-flex.flex-column.h-100.p-4
    form#form-registrar-turno.row.shadow-lg.rounded.border.bg-light.p-4.d-flex.flex-column.flex-grow-1.justify-content-between(novalidate autocomplete="off")

      h4.text-center.mt-4
        i.bi.bi-calendar-plus-fill.me-2
        | Registrar Nuevo Turno

      .row.g-4.mt-0
        //- Columna Izquierda: Participantes
        .col-lg-12.d-flex.flex-column.gap-4
          .p-4.border.rounded.bg-white.shadow-sm.h-100
            h6.text-muted.text-uppercase.fw-bold.mb-3 
              i.bi.bi-people.me-2
              | Información de los Participantes
            
            .row.g-3
              .col-12
                label.form-label.fw-bold(for="select-medico") Buscar Médico
                select#select-medico.form-select(name="medico_id" required style="width: 100%;")
                  if medicoPreseleccionado
                    option(value=medicoPreseleccionado.id selected) #{medicoPreseleccionado.nombre} #{medicoPreseleccionado.apellido} (DNI: #{medicoPreseleccionado.dni})
                .invalid-feedback#error-medico_id El médico es obligatorio.
              .col-12
                label.form-label.fw-bold(for="select-paciente") Buscar Paciente
                select#select-paciente.form-select(name="paciente_id" required style="width: 100%;")
                  if pacientePreseleccionado
                    - const dni = pacientePreseleccionado.identificaciones && pacientePreseleccionado.identificaciones.length > 0 ? pacientePreseleccionado.identificaciones[0].nro_doc : 'S/D'
                    option(value=pacientePreseleccionado.id selected) #{pacientePreseleccionado.nombre} #{pacientePreseleccionado.apellido} (DNI: #{dni})
                .invalid-feedback#error-paciente_id El paciente es obligatorio.

        //- Columna Derecha: Detalles del Turno
        .col-lg-12
          .h-100.p-4.border.rounded.bg-white.shadow-sm
            h6.text-muted.text-uppercase.fw-bold.mb-3 
              i.bi.bi-calendar-event.me-2
              | Detalles del Turno

            .row.g-3
              .col-12
                label.form-label.fw-bold(for="fecha") Fecha
                input.form-control(type="date" id="fecha" name="fecha" required)
                .invalid-feedback#error-fecha La fecha es obligatoria.

              - var timeSlots = [];
              - for(var h = 0; h < 24; h++) {
              -   for(var m = 0; m < 60; m += 30) {
              -     var time = (h < 10 ? '0' : '') + h + ':' + (m < 10 ? '0' : '') + m;
              -     timeSlots.push(time);
              -   }
              - }

              .col-md-6
                label.form-label.fw-bold(for="hora_inicio") Hora de Inicio
                select.form-select(id="hora_inicio" name="hora_inicio" required)
                  option(value="" selected disabled) Seleccione hora
                  each time in timeSlots
                    option(value=time)= time
                .invalid-feedback#error-hora_inicio La hora de inicio es obligatoria.
              .col-md-6
                label.form-label.fw-bold(for="hora_fin") Hora de Fin
                select.form-select(id="hora_fin" name="hora_fin" required)
                  option(value="" selected disabled) Seleccione hora
                  each time in timeSlots
                    option(value=time)= time
                .invalid-feedback#error-hora_fin La hora de fin es obligatoria.
              .col-12
                label.form-label.fw-bold(for="motivo") Motivo de la Consulta
                textarea.form-control(id="motivo" name="motivo" required rows="3" placeholder="Ej. Consulta general, Dolor de cabeza...")
                .invalid-feedback#error-motivo El motivo es obligatorio.

      //- Botones de acción
      .col-12.d-flex.justify-content-end.gap-2.mt-4
        a.btn.btn-secondary(href="/turnos") Cancelar
        button.btn.btn-success.px-4(type="submit")
          i.bi.bi-save-fill.me-2
          | Registrar Turno

block scripts
  //- jQuery y Select2 JS
  script(src="https://code.jquery.com/jquery-3.6.0.min.js")
  script(src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js")

  //- Script de validación y envío del formulario
  script(src="/js/turno/formTurnoRegister.js")

  script(src="/js/medico/buscarMedico.js")
  script(src="/js/paciente/buscarPaciente.js")