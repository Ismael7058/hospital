extends ../layout.pug

block styles
  link(rel="stylesheet", href="/css/dashboard.css")
  style.
    .bed-icon { font-size: 1.5rem; }
    .status-dot { height: 10px; width: 10px; border-radius: 50%; display: inline-block; margin-right: 5px; }

block content
  .container-fluid.p-4
    .card.shadow-lg.border-0.d-flex.flex-column.flex-grow-1.p-4.bg-body-tertiary
      .d-flex.justify-content-between.align-items-center.mb-4
        h1.h3.mb-0.text-gray-800 Panel de Control
        span.text-muted #{new Date().toLocaleDateString('es-ES', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}

      //- A. KPIs - Fila 1: Flujo de Pacientes y Actividad
      .row.g-3.mb-3
        //- Pacientes Activos
        .col-2
          a.text-decoration-none(href="/pacientes?activo=true")
            .card.shadow-sm.border-start.border-primary.border-4.h-100
              .card-body.p-3
                .text-primary.text-uppercase.fw-bold.small.mb-1 Pacientes Activos
                .h4.mb-0.fw-bold.text-gray-800= estadisticas.kpis.pacientesActivos
        
        //- Admisiones Hoy
        .col-2
          a.text-decoration-none(href=`/admisiones?fecha=${new Date().toISOString().split('T')[0]}`)
            .card.shadow-sm.border-start.border-success.border-4.h-100
              .card-body.p-3
                .text-success.text-uppercase.fw-bold.small.mb-1 Admisiones Hoy
                .h4.mb-0.fw-bold.text-gray-800= estadisticas.kpis.admisionesHoy

        //- Pacientes en Espera
        .col-2
          a.text-decoration-none(href=`/admisiones?estado_atencion=En+Espera`)
            .card.shadow-sm.border-start.border-danger.border-4.h-100
              .card-body.p-3
                .text-danger.text-uppercase.fw-bold.small.mb-1 En Espera
                .d-flex.align-items-baseline
                  .h4.mb-0.fw-bold.text-gray-800= estadisticas.kpis.pacientesEnEspera

        //- Emergencias
        .col-2
          a.text-decoration-none(href="/admisiones?via_ingreso_id=1")
            .card.shadow-sm.border-start.border-warning.border-4.h-100
              .card-body.p-3
                .text-warning.text-uppercase.fw-bold.small.mb-1 Emergencias
                .h4.mb-0.fw-bold.text-gray-800= estadisticas.kpis.emergenciasHoy

        //- Turnos Hoy
        .col-2
          a.text-decoration-none(href="/turnos?fecha=" + new Date().toISOString().split('T')[0])
            .card.shadow-sm.border-start.border-primary.border-4.h-100
              .card-body.p-3
                .text-primary.text-uppercase.fw-bold.small.mb-1 Turnos Hoy
                .h4.mb-0.fw-bold.text-gray-800= estadisticas.kpis.turnosHoy

      .row
        //- B. Turnos del Día
        .col-lg-12.mb-2
          .card.shadow-sm.mb-4
            .card-header.bg-white.py-3.d-flex.justify-content-between.align-items-center
              h6.m-0.font-weight-bold.text-primary Turnos del Día
              a.btn.btn-sm.btn-primary(href="/turnos/registrar") Nuevo Turno
            .card-body.p-0
              .table-responsive
                table.table.table-hover.align-middle.mb-0
                  thead.bg-light
                    tr
                      th.ps-4 Hora
                      th Paciente
                      th Profesional
                      th Estado
                      th.text-end.pe-4 Acciones
                  tbody
                    if estadisticas.turnosHoyList.length > 0
                      each turno in estadisticas.turnosHoyList
                        tr
                          td.ps-4.fw-bold= turno.hora_inicio.slice(0,5)
                          td= turno.paciente ? turno.paciente.nombre + ' ' + turno.paciente.apellido : 'Sin Paciente'
                          td= turno.medico ? turno.medico.nombre + ' ' + turno.medico.apellido : 'Sin Asignar'
                          td
                            if turno.estado == 'Pendiente'
                              span.badge.bg-warning.text-dark Pendiente
                            else if turno.estado == 'Confirmado'
                              span.badge.bg-primary Confirmado
                            else if turno.estado == 'Atendido'
                              span.badge.bg-success Atendido
                            else if turno.estado == 'Cancelado'
                              span.badge.bg-danger Cancelado
                            else
                              span.badge.bg-secondary= turno.estado
                          td.text-end.pe-4
                            a.btn.btn-sm.btn-outline-primary.me-1(href=`/turnos/${turno.id}` title="Ver Detalle")
                              i.bi.bi-eye
                    else
                      tr
                        td.text-center.py-4(colspan="5") No hay turnos programados para hoy.

          //- C. Estado de Camas
          .card.shadow-sm
            .card-header.bg-white.py-3.d-flex.justify-content-between.align-items-center
              h6.m-0.font-weight-bold.text-success Estado de Camas
              div
                span.badge.bg-success.me-1 Libre
                span.badge.bg-danger.me-1 Ocupada
                span.badge.bg-warning.text-dark.me-1 Limpieza
            .card-body
              if estadisticas.infraestructura.length > 0
                each ala in estadisticas.infraestructura
                  if ala.habitaciones && ala.habitaciones.length > 0
                    h6.fw-bold.text-secondary.mb-2.mt-3= ala.nombre
                    .row.g-2.mb-3
                      each habitacion in ala.habitaciones
                        .col-auto
                          .border.rounded.p-2.text-center(style="min-width: 80px;")
                            small.d-block.fw-bold.mb-1 Hab #{habitacion.numero}
                            .d-flex.justify-content-center.flex-wrap(style="gap: 4px;")
                              if habitacion.camas && habitacion.camas.length > 0
                                each cama in habitacion.camas
                                  - var colorClass = 'text-success'
                                  - var title = 'Libre'
                                  if cama.estado == 'Ocupado'
                                    - colorClass = 'text-danger'
                                    - title = 'Ocupada'
                                  else if cama.estado == 'Higienizando'
                                    - colorClass = 'text-warning'
                                    - title = 'En Limpieza'
                                  
                                  i.bi.bi-square-fill(class=colorClass title=`Cama ${cama.codigo}: ${title}` data-bs-toggle="tooltip")
                              else
                                small.text-muted Sin camas
              else
                p.text-center.text-muted No hay información de infraestructura disponible.

block scripts
  script.
    // Inicializar tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
      return new bootstrap.Tooltip(tooltipTriggerEl)
    })
