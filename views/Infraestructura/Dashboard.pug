extends ../layout

block styles
  link(rel="stylesheet", href="/css/dashboard.css")

block content

  .container-fluid.p-4.d-flex.flex-column.h-100
    .card.shadow-lg.border-0.d-flex.flex-column.flex-grow-1.p-4.bg-body-tertiary
      //- Encabezado de la página
      .d-flex.justify-content-center.pt-3.pb-2.mb-3.border-bottom
        h1.display-6.fw-semibold= title

      //- Tarjetas de Resumen (KPIs)
      .row.mb-4
        a.col-xl-3.col-md-6.mb-4.text-decoration-none(href="/infraestructura/alas")
          .card.shadow-sm.h-100.border-0.rounded-4.dashboard-card.bg-light-subtle
            .card-body
              .row.g-0.align-items-center
                .col.me-2
                  .text-primary.text-uppercase.fw-bold.mb-1
                    small Total de Alas
                  span.h5.mb-0.fw-bold.text-secondary= stats.totalAlas
                .col-auto
                  i.bi.bi-hospital.fs-2.text-body-tertiary

        a.col-xl-3.col-md-6.mb-4.text-decoration-none(href="/infraestructura/habitaciones")
          .card.shadow-sm.h-100.border-0.rounded-4.dashboard-card.bg-light-subtle
            .card-body
              .row.g-0.align-items-center
                .col.me-2
                  .text-success.text-uppercase.fw-bold.mb-1
                    small Total de Habitaciones
                  span.h5.mb-0.fw-bold.text-secondary= stats.totalHabitaciones
                .col-auto
                  i.bi.bi-door-open.fs-2.text-body-tertiary

        a.col-xl-3.col-md-6.mb-4.text-decoration-none(href="/infraestructura/camas?estado=Libre")
          .card.shadow-sm.h-100.border-0.rounded-4.dashboard-card.bg-light-subtle
            .card-body
              .row.g-0.align-items-center
                .col.me-2
                  .text-info.text-uppercase.fw-bold.mb-1
                    small Camas Disponibles
                  span.h5.mb-0.fw-bold.text-secondary= `${stats.camasDisponibles} / ${stats.totalCamas}`
                .col-auto
                  i.bi.bi-bed.fs-2.text-body-tertiary

        .col-xl-3.col-md-6.mb-4
          .card.shadow-sm.h-100.border-0.rounded-4.dashboard-card.bg-light-subtle
            .card-body
              .row.g-0.align-items-center
                .col.me-2
                  .text-warning.text-uppercase.fw-bold.mb-1
                    small Tasa de Ocupación
                  span.h5.mb-0.fw-bold.text-secondary= `${stats.tasaOcupacion}%`
                .col-auto
                  i.bi.bi-pie-chart.fs-2.text-body-tertiary

      //- Visualización Jerárquica
      .row
        .col-12
          h3.mb-3 Estructura del Hospital
          if alas && alas.length > 0
            .accordion#accordionEstructura
              each ala, index in alas
                .accordion-item
                  h2.accordion-header.d-flex.align-items-center(id=`heading-${ala.id}`)
                    button.accordion-button.collapsed(type='button', data-bs-toggle='collapse', data-bs-target=`#collapse-${ala.id}`, aria-expanded='false', aria-controls=`collapse-${ala.id}`)
                      strong= ala.nombre
                      span.ms-2.badge.bg-secondary #{ala.habitaciones.length} Habitaciones
                  .accordion-collapse.collapse.bg-white(id=`collapse-${ala.id}`, aria-labelledby=`heading-${ala.id}`, data-bs-parent='#accordionEstructura')
                    .accordion-body.pb-0
                      if ala.habitaciones.length > 0
                        ul.list-group
                          each habitacion in ala.habitaciones
                            li.list-group-item.d-flex.justify-content-between.align-items-center
                              div
                                | Habitación #{habitacion.numero}
                                span.ms-2.badge.bg-primary.rounded-pill #{habitacion.camas.length} Camas
                              a.btn.btn-sm.btn-outline-secondary(href=`/infraestructura/camas?habitacion_id=${habitacion.id}`, title="Ver camas de esta habitación")
                                i.bi.bi-arrow-right-circle
                        .w-100.d-flex.justify-content-end.p-3
                          a.btn.btn-sm.btn-outline-primary.ms-auto.me-2(href=`/infraestructura/habitaciones?ala_id=${ala.id}`, title="Ver habitaciones de esta ala")
                            span.me-1 Ver Mas
                            i.bi.bi-arrow-right-circle
                      else
                        p No hay habitaciones registradas en esta ala.
          else
            .alert.alert-info No hay alas registradas en el sistema.
