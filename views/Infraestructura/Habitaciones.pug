extends ../layout

block styles
  //- Select2 CSS para Bootstrap 5
  link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css")
  link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css")


block content
  .container-fluid.p-4.d-flex.flex-column.h-100
    .card.shadow-lg.border-0.d-flex.flex-column.flex-grow-1
      .card-header.bg-light.d-flex.justify-content-between.align-items-center.py-3
        div
          h4.mb-0 Listado de Habitaciones
        div
          a.btn.btn-outline-secondary.me-2(href="/infraestructura") Volver
          button.btn.btn-secondary.me-2(type="button" data-bs-toggle="collapse" data-bs-target="#filtrosCollapse")
            i.bi.bi-funnel.me-2
            | Filtros
          button.btn.btn-success(type="button" data-bs-toggle="modal" data-bs-target="#modalHabitacion")
            i.bi.bi-plus-lg.me-2
            | Nueva Habitación

      .collapse#filtrosCollapse
        form.card-body.border-bottom.px-4(method="GET" action="/infraestructura/habitaciones")
          .row.g-3.align-items-end
            .col-md-3
              label.form-label(for="numero") Número
              input.form-control(type="text" id="numero" name="numero" value=filtros.numero)
            .col-md-3
              label.form-label(for="capacidad") Capacidad
              input.form-control(type="number" id="capacidad" name="capacidad" value=filtros.capacidad)
            .col-md-3
              label.form-label(for="ala_id") Ala
              select.form-select(id="ala_id" name="ala_id")
                option(value="") Todas las alas
                each ala in alas
                  option(value=ala.id selected=(filtros.ala_id == ala.id))= ala.nombre
            .col-md-3
              label.form-label(for="activo") Estado
              select.form-select(id="activo" name="activo")
                option(value="") Todos
                option(value="true" selected=(filtros.activo === 'true')) Activo
                option(value="false" selected=(filtros.activo === 'false')) Inactivo
            .col-md-3
              label.form-label(for="conCamasLibres") Con Camas Libres
              select.form-select(id="conCamasLibres" name="conCamasLibres")
                option(value="" selected=(filtros.conCamasLibres === '')) Cualquiera
                option(value="true" selected=(filtros.conCamasLibres === 'true')) Sí
                option(value="false" selected=(filtros.conCamasLibres === 'false')) No
            .col-12.text-end
              a.btn.btn-secondary(href="/infraestructura/habitaciones") Limpiar
              button.btn.btn-primary.ms-2(type="submit") Filtrar

      .card-body.flex-grow-1.d-flex.flex-column.p-0.overflow-hidden.px-4.pt-4
        .table-responsive.table-fixed-height.rounded
          table.table.table-striped.table-hover.align-middle
            thead.table-dark
              tr
                th.text-center Número
                th Ala
                th Descripción
                th.text-center Capacidad
                th.text-center Camas Libres
                th.text-center Estado
                th.text-center Acciones

            tbody
              if habitaciones && habitaciones.length > 0
                each habitacion in habitaciones
                  tr
                    td.text-center= habitacion.numero
                    td= habitacion.ala ? habitacion.ala.nombre : 'N/A'
                    td= habitacion.descripcion
                    td.text-center= habitacion.capacidad
                    td.text-center
                      span.badge(class=habitacion.dataValues.camasLibres > 0 ? 'bg-info' : 'bg-secondary')= habitacion.dataValues.camasLibres
                    td.text-center
                      if habitacion.activo
                        span.badge.bg-success Activo
                      else
                        span.badge.bg-danger Inactivo
                    td.text-center
                      button.btn.btn-primary.btn-sm.me-2.btn-editar-habitacion(
                        type="button",
                        data-bs-toggle="modal",
                        data-bs-target="#modalHabitacion",
                        data-id=habitacion.id,
                        data-url=`/api/infraestructura/habitacion/${habitacion.id}`,
                        title="Gestionar Habitación"
                      )
                        i.bi.bi-pencil-square
                      a.btn.btn-info.btn-sm.me-2(href=`/infraestructura/camas?habitacion_id=${habitacion.id}` title="Ver Camas")
                        i.bi.bi-door-open
                      button.btn.btn-sm.btn-secondary.btn-toggle-activo(type="button" data-id=habitacion.id data-activo=String(habitacion.activo))
                        if habitacion.activo
                          i.bi.bi-toggle-off.me-1
                          | Desactivar
                        else
                          i.bi.bi-toggle-on.me-1
                          | Activar
                - const filasVacias = 13 - habitaciones.length;
                if filasVacias > 0
                  - for (let i = 0; i < filasVacias; i++)
                    tr
                      td.text-center(colspan="7") &nbsp;
          if !habitaciones || habitaciones.length === 0
            .position-absolute.top-50.start-50.translate-middle.text-center.text-muted
              h4.fw-light No se encontraron habitaciones con los filtros aplicados

      //- Paginación
      if paginacion && paginacion.totalPaginas > 1
        .card-footer.justify-content-center.d-flex.align-items-center
          div.text-muted.col-2
            small Página #{paginacion.paginaActual} de #{paginacion.totalPaginas} (#{paginacion.totalRegistros} registros)
          include ../Shared/Paginacion.pug

  //- Modal para crear/editar habitación, con un selector para buscar el ala
  #modalHabitacion.modal.fade(tabindex="-1" aria-labelledby="modalHabitacionLabel" aria-hidden="true")
    .modal-dialog.modal-dialog-centered
      .modal-content
        .modal-header
          h5.modal-title#modalHabitacionLabel Formulario de Habitacion
          button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
        .modal-body
          form#formHabitacion
            input(type="hidden" id="habitacionId" name="id")
            .mb-3
              label.form-label(for="select-ala") Ala
              select#select-ala.form-select(name="ala_id" required style="width: 100%;")
              .invalid-feedback#error-ala_id
            .mb-3
              label.form-label(for="numeroHabitacion") Número de Habitación
              input.form-control(type="text" id="numeroHabitacion" name="numero" required)
              .invalid-feedback#error-numero
            .mb-3
              label.form-label(for="capacidadHabitacion") Capacidad
              input.form-control(type="number" id="capacidadHabitacion" name="capacidad" required min="1" max="2")
              .invalid-feedback#error-capacidad
            .mb-3
              label.form-label(for="descripcionHabitacion") Descripción
              textarea.form-control(id="descripcionHabitacion" name="descripcion" rows="3" required)
              .invalid-feedback#error-descripcion

        .modal-footer
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cerrar
          button.btn.btn-primary(type="submit" form="formHabitacion") Guardar


  //- Modal para Confirmar Activación/Desactivación
  #confirmarEstadoHabitacionModal.modal.fade(tabindex="-1" aria-labelledby="confirmarEstadoHabitacionModalLabel" aria-hidden="true")
    .modal-dialog
      .modal-content
        .modal-header
          h5.modal-title#confirmarEstadoHabitacionModalLabel Confirmar Acción
          button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
        .modal-body
          p#confirmarEstadoHabitacionModalBody ¿Estás seguro?
        .modal-footer
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
          button.btn.btn-danger#confirmarEstadoHabitacionBtn(type="button") Confirmar

block scripts
  //- jQuery y Select2 JS
  script(src="https://code.jquery.com/jquery-3.6.0.min.js")
  script(src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js")
  script(src="/js/infraestructura/modalHabitaciones.js")
  script(src="/js/infraestructura/estadoHabitacion.js")