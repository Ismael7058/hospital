extends ../layout

block styles
  //- Select2 CSS para Bootstrap 5
  link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css")
  link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css")



block content
  .container-fluid.p-4.d-flex.flex-column.h-100
    .card.shadow-lg.border-0.d-flex.flex-column.flex-grow-1
      .card-header.bg-light.d-flex.justify-content-between.align-items-center.py-3
        div
          h4.mb-0 Listado de Camas
        div
          a.btn.btn-outline-secondary.me-2(href="/infraestructura") Volver
          button.btn.btn-secondary.me-2(type="button" data-bs-toggle="collapse" data-bs-target="#filtrosCollapse")
            i.bi.bi-funnel.me-2
            | Filtros
          button.btn.btn-success(type="button" data-bs-toggle="modal" data-bs-target="#modalCama")
            i.bi.bi-plus-lg.me-2
            | Nueva Cama

      .collapse#filtrosCollapse
        form.card-body.border-bottom.px-4(method="GET" action="/infraestructura/camas")
          .row.g-3.align-items-end
            .col-md-3
              label.form-label(for="codigo") Código
              input.form-control(type="text" id="codigo" name="codigo" value=filtros.codigo)
            .col-md-3
              label.form-label(for="ala_id") Ala
              select.form-select(id="ala_id" name="ala_id")
                option(value="") Todas
                each ala in alas
                  option(value=ala.id selected=(filtros.ala_id == ala.id))= ala.nombre
            .col-md-3
              label.form-label(for="habitacion_id") Habitación
              select.form-select(id="habitacion_id" name="habitacion_id")
                option(value="") Todas
                each habitacion in habitaciones
                  option(value=habitacion.id selected=(filtros.habitacion_id == habitacion.id))= `N° ${habitacion.numero}`
            .col-md-3
              label.form-label(for="estado") Estado Cama
              select.form-select(id="estado" name="estado")
                option(value="") Todos
                option(value="Libre" selected=(filtros.estado === 'Libre')) Libre
                option(value="Ocupado" selected=(filtros.estado === 'Ocupado')) Ocupado
                option(value="Higienizando" selected=(filtros.estado === 'Higienizando')) Higienizando
            .col-md-3
              label.form-label(for="activo") Estado Activo
              select.form-select(id="activo" name="activo")
                option(value="") Todos
                option(value="true" selected=(filtros.activo === 'true')) Activo
                option(value="false" selected=(filtros.activo === 'false')) Inactivo
            .col-12.text-end
              a.btn.btn-secondary(href="/infraestructura/camas") Limpiar
              button.btn.btn-primary.ms-2(type="submit") Filtrar

      .card-body.flex-grow-1.d-flex.flex-column.p-0.overflow-hidden.px-4.pt-4
        .table-responsive.table-fixed-height.rounded
          table.table.table-striped.table-hover.align-middle
            thead.table-dark
              tr
                th.text-center Código
                th Ala
                th Habitación
                th.text-center Estado Cama
                th.text-center Activo
                th.text-center Acciones

            tbody
              if camas && camas.length > 0
                each cama in camas
                  tr
                    td.text-center= cama.codigo
                    td= cama.habitacion && cama.habitacion.ala ? cama.habitacion.ala.nombre : 'N/A'
                    td= cama.habitacion ? `N° ${cama.habitacion.numero}` : 'N/A'
                    td.text-center
                      case cama.estado
                        when 'Libre'
                          span.badge.bg-success Libre
                        when 'Ocupado'
                          span.badge.bg-danger Ocupado
                        when 'Higienizando'
                          span.badge.bg-warning.text-dark Higienizando
                        default
                          span.badge.bg-secondary= cama.estado
                    td.text-center
                      if cama.activo
                        span.badge.bg-success Sí
                      else
                        span.badge.bg-danger No
                    td.text-center
                      button.btn.btn-primary.btn-sm.me-2.btn-editar-cama(type="button" data-bs-toggle="modal" data-bs-target="#modalCama" data-id=cama.id data-url=`/api/infraestructura/cama/${cama.id}` title="Gestionar Cama")
                        i.bi.bi-pencil-square
                      button.btn.btn-secondary.btn-sm.me-2(type="button" data-bs-toggle="modal" data-bs-target="#modalHistorial" data-id=cama.id title="Ver Historial de Higienización")
                        i.bi.bi-clock-history
                      button.btn.btn-sm.btn-info.btn-toggle-activo(type="button" data-id=cama.id data-activo=String(cama.activo))
                        if cama.activo
                          i.bi.bi-toggle-off.me-2
                          | Desactivar
                        else
                          i.bi.bi-toggle-on.me-2
                          | Activar
                - const filasVacias = 15 - camas.length;
                if filasVacias > 0
                  - for (let i = 0; i < filasVacias; i++)
                    tr
                      td.text-center(colspan="6") &nbsp;
          if !camas || camas.length === 0
            .position-absolute.top-50.start-50.translate-middle.text-center.text-muted
              h4.fw-light No se encontraron camas con los filtros aplicados

      //- Paginación
      if paginacion && paginacion.totalPaginas > 1
        .card-footer.justify-content-center.d-flex.align-items-center
          div.text-muted.col-2
            small Página #{paginacion.paginaActual} de #{paginacion.totalPaginas} (#{paginacion.totalRegistros} registros)
          include ../Shared/Paginacion.pug

  //- Modal para crear/editar cama
  #modalCama.modal.fade(tabindex="-1" aria-labelledby="modalCamaLabel" aria-hidden="true")
    .modal-dialog.modal-dialog-centered
      .modal-content
        .modal-header
          h5.modal-title#modalCamaLabel Formulario de Cama
          button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
        .modal-body
          form#formCama
            input(type="hidden" id="camaId" name="id")
            .mb-3
              label.form-label(for="camaCodigo") Código de la Cama
              input.form-control(type="text" id="camaCodigo" name="codigo" required)
              .invalid-feedback#error-codigo
            .mb-3
              label.form-label(for="select-ala") Ala
              select#select-ala.form-select(name="ala_id" required style="width: 100%;")
              .invalid-feedback#error-ala_id
            .mb-3
              label.form-label(for="select-habitacion") Habitación
              select#select-habitacion.form-select(name="habitacion_id" required style="width: 100%;" disabled)
              .invalid-feedback#error-habitacion_id
        .modal-footer
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cerrar
          button.btn.btn-primary(type="submit" form="formCama") Guardar


  //- Modal para Confirmar Activación/Desactivación
  #confirmarEstadoCamaModal.modal.fade(tabindex="-1" aria-labelledby="confirmarEstadoCamaModalLabel" aria-hidden="true")
    .modal-dialog
      .modal-content
        .modal-header
          h5.modal-title#confirmarEstadoCamaModalLabel Confirmar Acción
          button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
        .modal-body
          p#confirmarEstadoCamaModalBody ¿Estás seguro?
        .modal-footer
          button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancelar
          button.btn.btn-danger#confirmarEstadoCamaBtn(type="button") Confirmar

block scripts
  //- jQuery y Select2 JS
  script(src="https://code.jquery.com/jquery-3.6.0.min.js")
  script(src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js")
  script(src="/js/infraestructura/modalCama.js")
  script(src="/js/infraestructura/estadoCama.js")